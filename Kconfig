    string "BT profile 2 display label"
    default ""

config ZMK_ESP32_BT_PROFILE_3_LABEL
    string "BT profile 3 display label"
    default ""

config ZMK_ESP32_BT_PROFILE_4_LABEL
    string "BT profile 4 display label"
    default ""

config ZMK_ESP32_BT_PROFILE_5_LABEL
    string "BT profile 5 display label"
    default ""

config ZMK_ESP32_BT_PROFILE_6_LABEL
    string "BT profile 6 display label"
    default ""

